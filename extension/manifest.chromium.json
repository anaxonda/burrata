{
  "manifest_version": 3,
  "name": "Burrata Browser Companion",
  "version": "0.2.4",
  "description": "Import public music pages and optionally connect your browser session to the local Burrata desktop app.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://www.beatport.com/*",
    "https://www.traxsource.com/*",
    "https://open.spotify.com/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://francescograzioso.github.io/Meld/*",
    "https://api.github.com/gists/*",
    "https://www.shazam.com/*",
    "https://shazam.com/*",
    "https://www.last.fm/*",
    "https://last.fm/*",
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/burrata-16.png",
      "32": "icons/burrata-32.png",
      "48": "icons/burrata-48.png",
      "128": "icons/burrata-128.png"
    },
    "default_title": "Burrata Browser Companion"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "parsers.js"
      ],
      "matches": [
        "https://www.beatport.com/*",
        "https://www.traxsource.com/*",
        "https://open.spotify.com/*",
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://www.shazam.com/*",
        "https://shazam.com/*",
        "https://www.last.fm/*",
        "https://last.fm/*",
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "icons": {
    "16": "icons/burrata-16.png",
    "32": "icons/burrata-32.png",
    "48": "icons/burrata-48.png",
    "128": "icons/burrata-128.png"
  }
}
