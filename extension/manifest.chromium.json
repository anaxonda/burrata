{
  "manifest_version": 3,
  "name": "Burrata Browser Companion",
  "version": "0.2.1",
  "description": "Import public chart, playlist, and album metadata into the local Burrata desktop app.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://www.beatport.com/*",
    "https://www.traxsource.com/*",
    "https://open.spotify.com/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://francescograzioso.github.io/Meld/*",
    "https://api.github.com/gists/*",
    "https://www.shazam.com/*",
    "https://shazam.com/*",
    "https://www.last.fm/*",
    "https://last.fm/*",
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "parsers.js"
      ],
      "matches": [
        "https://www.beatport.com/*",
        "https://www.traxsource.com/*",
        "https://open.spotify.com/*",
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://www.shazam.com/*",
        "https://shazam.com/*",
        "https://www.last.fm/*",
        "https://last.fm/*",
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
