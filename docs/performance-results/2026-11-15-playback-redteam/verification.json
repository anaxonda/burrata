  "findings": [
    {
      "name": "Unrepresentable seek panics a decoder worker",
      "before": "An accepted seek to 1e300 seconds panicked the decoder and left the player buffering until its watchdog.",
      "fix": "Validate positions before mutating playback; check decoder clock and sample-counter ranges; contain codec panics in the ordinary failure path.",
      "regressions": [
        "extreme_finite_seek_does_not_crash",
        "native decoder worker panic and seek-boundary unit tests"
      ]
    },
    {
      "name": "Clean EOF after a seek is discarded before first PCM",
      "before": "Seeking to 30 seconds in a 24-second local file produced clean EOF, but the playing-only completion guard ignored it while buffering. The player waited for the seek watchdog.",
      "fix": "Complete the owned seek occurrence on clean empty EOF, preserving duration and excluding empty seek completion from verified decoded coverage. Respect pause and generation ownership.",
      "regressions": [
        "seek_past_physical_eof",
        "seek_to_end_advances_once",
        "paused and stale generation EOF unit tests"
      ]
    },
    {
      "name": "Unexpected decoder termination cannot recover valid local audio",
      "before": "SIGKILL of the isolated packaged FFmpeg process was classified unknown/non-retryable; local assets also failed the candidate eligibility check. The same failure occurred after resuming a paused decoder.",
      "fix": "Classify unexpected decoder termination as a source-scoped output failure and permit local decoder restarts through existing bounded recovery. Preserve retry limits, cancellation, deadlines, and device-error handling.",
      "regressions": [
        "killed_owned_decoder_restarts_same_recording",
        "decoder_death_while_paused_resumes_valid_audio",
        "repeated_decoder_death_has_finite_retries"
      ]
    }
  ],
