{
  "name": "burrata",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "vite build --configLoader runner",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test": "vitest run --configLoader runner",
    "test:watch": "bash scripts/dev/test-frontend-watch.sh",
    "test:native:exact": "bash scripts/dev/test-native-exact.sh",
    "test:extension": "node --test extension/tests/*.test.mjs",
    "test:mcp": "node --test mcp/*.test.js",
    "mcp:start": "node mcp/server.js",
    "extension:chrome": "python3 scripts/build_browser_extension.py",
    "test:player": "node src-tauri/src/player/player.test.cjs",
    "build:mcp": "node scripts/build_mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "hls.js": "1.7.3",
    "svelte": "^5.55.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.12"
  }
